# OpenAI 配置（必填才能使用 AI 分析；行情与事件不依赖它）
OPENAI_API_KEY=
# 显式填写你有权限调用的模型，例如 gpt-4.1-mini / gpt-4o-mini
OPENAI_MODEL=
# 可选：兼容 OpenAI 接口的第三方网关地址，留空使用官方接口
OPENAI_BASE_URL=

# 服务监听
APP_HOST=127.0.0.1
APP_PORT=8000

# 本地数据库文件（相对仓库根目录或绝对路径）
DATABASE_PATH=data/assistant.db

# 外部行情/资讯请求超时（秒）
REQUEST_TIMEOUT_SECONDS=12
# 模型调用超时（秒）
AI_TIMEOUT_SECONDS=90
